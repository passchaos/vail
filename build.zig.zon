.{
    .name = .vail,
    .version = "0.1.0",
    .fingerprint = 0xd63e_7cd6_31a7_8dd7,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Development path dependency. CI checks out passchaos/vort at the
        // commit documented in docs/building.md.
        .vort = .{
            .path = "../vort",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build_support",
        "src",
        "bench",
        "test",
        "tools",
        "archive_crypto",
        "docs",
        "examples",
        "README.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "CHANGELOG.md",
        "THIRD_PARTY_NOTICES.md",
        "LICENSE",
        ".gitignore",
    },
}
